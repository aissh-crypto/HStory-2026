rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Document and all nested subcollections (saved, caseFiles, chats, inspections)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Subcollection: Saved Properties
      match /saved/{propertyId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: Case Files and their nested chats / media
      match /caseFiles/{caseId} {
        allow read, write: if isOwner(userId);

        match /{allChildren=**} {
          allow read, write: if isOwner(userId);
        }
      }

      // Subcollection: Live Camera Inspections
      match /inspections/{inspectionId} {
        allow read, write: if isOwner(userId);
      }

      // Catch-all for any user subcollections
      match /{allChildren=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}

